   {
    "id": "intro",
    "role": "intro",
    "text": {
     "zh": "扶椅站姿后踢腿，练臀部",
     "en": "Chair-supported standing kickback. Works the glutes."
    },
    "ms": {
     "zh": 2299,
     "en": 3622
    }
   },
   {
    "id": "cue1",
    "role": "cue",
    "text": {
     "zh": "扶椅站稳，躯干不前倾",
     "en": "Hold the chair, stand steady, do not lean forward"
    },
    "ms": {
     "zh": 2159,
     "en": 2972
    }
   },
   {
    "id": "cue2",
    "role": "cue",
    "text": {
     "zh": "扶稳椅背，腿向后抬，腰不要塌",
     "en": "Hold the chair back, lift the leg behind you, do not arch your back"
    },
    "ms": {
     "zh": 2879,
     "en": 3599
    }
   },
   {
    "id": "cue3",
    "role": "cue",
    "text": {
     "zh": "腿向后上方踢，臀部收紧",
     "en": "Kick the leg back and up, squeeze your glutes"
    },
    "ms": {
     "zh": 2485,
     "en": 2392
    }
   },
   {
    "id": "side_switch",
    "role": "side_switch",
    "text": {
     "zh": "左侧同样，扶稳椅背，腿向后抬，腰不要塌",
     "en": "Now the left side. Hold the chair back, lift the leg behind you, do not arch your back"
    },
    "ms": {
     "zh": 4017,
     "en": 5550
    }
   },
   {
    "id": "rest",
    "role": "rest",
    "text": {
     "zh": "放松一下。下一组记住，腿向后上方踢，臀部收紧",
     "en": "Relax for a moment. Next set, remember: Kick the leg back and up, squeeze your glutes"
    },
    "ms": {
     "zh": 4992,
     "en": 6037
    }
   },
   {
    "id": "finish",
