    "text": {
     "zh": "侧卧反向蚌式，练臀部",
     "en": "Side-lying reverse clamshell. Works the glutes."
    },
    "ms": {
     "zh": 2299,
     "en": 3437
    }
   },
   {
    "id": "cue1",
    "role": "cue",
    "text": {
     "zh": "侧卧屈膝，膝盖并拢",
     "en": "Lie on your side, knees bent and together"
    },
    "ms": {
     "zh": 1997,
     "en": 2485
    }
   },
   {
    "id": "cue2",
    "role": "cue",
    "text": {
     "zh": "膝盖并拢，小腿慢慢向上抬",
     "en": "Knees together, lift the shin up slowly"
    },
    "ms": {
     "zh": 2670,
     "en": 2229
    }
   },
   {
    "id": "cue3",
    "role": "cue",
    "text": {
     "zh": "小腿向上抬起，做髋内旋",
     "en": "Lift the shin up to rotate the hip in"
    },
    "ms": {
     "zh": 2554,
     "en": 1881
    }
   },
   {
    "id": "side_switch",
    "role": "side_switch",
    "text": {
     "zh": "左侧同样，膝盖并拢，小腿慢慢向上抬",
     "en": "Now the left side. Knees together, lift the shin up slowly"
    },
    "ms": {
     "zh": 3785,
     "en": 4156
    }
   },
   {
    "id": "rest",
    "role": "rest",
    "text": {
     "zh": "放松一下。下一组记住，小腿向上抬起，做髋内旋",
     "en": "Relax for a moment. Next set, remember: Lift the shin up to rotate the hip in"
    },
    "ms": {
     "zh": 5062,
     "en": 5503
    }
   },
