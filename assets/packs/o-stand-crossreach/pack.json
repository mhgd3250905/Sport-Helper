    "role": "intro",
    "text": {
     "zh": "扶椅站姿交叉侧伸，拉伸臀部外侧",
     "en": "Chair-supported cross-leg side reach. Stretches the outer hips."
    },
    "ms": {
     "zh": 3158,
     "en": 4156
    }
   },
   {
    "id": "cue1",
    "role": "cue",
    "text": {
     "zh": "一条腿交叉到后面，手臂向上向侧面伸",
     "en": "Cross one leg behind, reach your arm up and over to the side"
    },
    "ms": {
     "zh": 3576,
     "en": 3181
    }
   },
   {
    "id": "cue2",
    "role": "cue",
    "text": {
     "zh": "手臂向侧上方伸，髋外侧拉长",
     "en": "Reach up and over, feel the outer hip lengthen"
    },
    "ms": {
     "zh": 2902,
     "en": 2461
    }
   },
   {
    "id": "side_switch",
    "role": "side_switch",
    "text": {
     "zh": "左侧同样，一条腿交叉到后面，手臂向上向侧面伸",
     "en": "Now the left side. Cross one leg behind, reach your arm up and over to the side"
    },
    "ms": {
     "zh": 4644,
     "en": 5108
    }
   },
   {
    "id": "rest",
    "role": "rest",
    "text": {
     "zh": "放松一下。下一组记住，手臂向侧上方伸，髋外侧拉长",
     "en": "Relax for a moment. Next set, remember: Reach up and over, feel the outer hip lengthen"
    },
