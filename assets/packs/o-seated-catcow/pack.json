   {
    "id": "cue1",
    "role": "cue",
    "text": {
     "zh": "坐椅前半，手放膝上",
     "en": "Sit on the front of the chair, hands on your knees"
    },
    "ms": {
     "zh": 1997,
     "en": 2531
    }
   },
   {
    "id": "cue2",
    "role": "cue",
    "text": {
     "zh": "坐在椅子前半部分，吸气挺胸，呼气拱背",
     "en": "On the front half of the chair, breathe in and lift your chest, breathe out and round your back"
    },
    "ms": {
     "zh": 3599,
     "en": 4667
    }
   },
   {
    "id": "cue3",
    "role": "cue",
    "text": {
     "zh": "挺胸抬头，再拱背低头",
     "en": "Chest up and look up, then round your back and look down"
    },
    "ms": {
     "zh": 2183,
     "en": 2833
    }
   },
   {
    "id": "rest",
    "role": "rest",
    "text": {
     "zh": "放松一下。下一组记住，挺胸抬头，再拱背低头",
     "en": "Relax for a moment. Next set, remember: Chest up and look up, then round your back and look down"
    },
    "ms": {
     "zh": 4667,
     "en": 6478
    }
