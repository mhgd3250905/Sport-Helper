    "ms": {
     "zh": 1556,
     "en": 2159
    }
   },
   {
    "id": "cue2",
    "role": "cue",
    "text": {
     "zh": "手臂伸直与肩同高，把弹力带向两侧拉开",
     "en": "Arms straight at shoulder height, pull the band apart"
    },
    "ms": {
     "zh": 3785,
     "en": 2624
    }
   },
   {
    "id": "cue3",
    "role": "cue",
    "text": {
     "zh": "向两侧拉开到胸前，肩不耸",
     "en": "Pull it apart to your chest, shoulders down"
    },
    "ms": {
     "zh": 2601,
     "en": 2392
    }
   },
   {
    "id": "rest",
    "role": "rest",
    "text": {
