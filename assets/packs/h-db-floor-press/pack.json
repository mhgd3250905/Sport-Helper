   {
    "id": "name",
    "role": "name",
    "text": {
     "zh": "哑铃地板卧推",
     "en": "Dumbbell floor press"
    },
    "ms": {
     "zh": 1324,
     "en": 1254
    }
   },
   {
    "id": "intro",
    "role": "intro",
    "text": {
     "zh": "哑铃地板卧推，练胸部和手臂后侧",
     "en": "Dumbbell floor press. Works the chest and the triceps."
    },
    "ms": {
     "zh": 3181,
     "en": 3878
    }
   },
   {
    "id": "cue1",
    "role": "cue",
    "text": {
     "zh": "仰卧屈膝，上臂贴地起始",
     "en": "Lie on your back, knees bent, upper arms on the floor"
    },
    "ms": {
     "zh": 2438,
     "en": 3042
    }
   },
   {
    "id": "cue2",
    "role": "cue",
    "text": {
     "zh": "大臂与身体约四十五度，推起时哑铃在胸口正上方",
     "en": "Upper arms about forty-five degrees from your body, press the dumbbells up over your chest"
    },
    "ms": {
     "zh": 4714,
     "en": 4551
    }
   },
   {
    "id": "cue3",
    "role": "cue",
    "text": {
     "zh": "向上推直，再慢慢落回",
     "en": "Press straight up, then lower slowly"
    },
    "ms": {
     "zh": 2299,
     "en": 2020
    }
   },
   {
    "id": "rest",
    "role": "rest",
    "text": {
     "zh": "放松一下。下一组记住，向上推直，再慢慢落回",
     "en": "Relax for a moment. Next set, remember: Press straight up, then lower slowly"
    },
    "ms": {
     "zh": 4807,
     "en": 5689
    }
   },
   {
    "id": "finish",
    "role": "finish",
    "text": {
     "zh": "哑铃地板卧推，完成",
     "en": "Dumbbell floor press, done."
    },
    "ms": {
     "zh": 2020,
     "en": 1788
    }
   }
