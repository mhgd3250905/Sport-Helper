{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mhgd3250905/3D-Pose-Hub/catalog/ai-tags/ai-tags.schema.json",
  "title": "Pose-Hub AI action tags (pose-hub-ai-tags@1)",
  "description": "每个定稿动作一个文件：catalog/ai-tags/actions/<id>.json。枚举值由 vocabulary.json 生成（vocabulary 0.1.0）；改词表后需同步本 schema，validate.py 会检查两者一致。stretchedMuscles 在 trainingType 含拉伸时必填，primaryMuscles 为空时 stretchedMuscles 必须非空，这些交叉规则由 validate.py 检查。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "vocabularyVersion",
    "status",
    "source",
    "scenes",
    "space",
    "floorRequired",
    "impact",
    "sweat",
    "requiredEquipment",
    "optionalEquipment",
    "substitutes",
    "trainingType",
    "movementPattern",
    "contraction",
    "plane",
    "bodyRegion",
    "primaryMuscles",
    "secondaryMuscles",
    "stabilizers",
    "joints",
    "difficulty",
    "intensity",
    "prerequisites",
    "laterality",
    "jointStress",
    "populationNotes",
    "sessionRole",
    "goals",
    "alternatives",
    "regressions",
    "progressions",
    "aiSummary",
    "confidence",
    "notes",
    "reviewNotes"
  ],
  "properties": {
    "format": {
      "const": "pose-hub-ai-tags@1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "vocabularyVersion": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ai-draft",
        "ai-cross-reviewed",
        "user-reviewed"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "text",
        "textSha256Lf"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "textSha256Lf": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "spec": {
          "type": "string"
        },
        "catalogV1": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "scenes": {
      "type": "array",
      "items": {
        "enum": [
          "home",
          "office",
          "gym",
          "outdoor",
          "hotel"
        ]
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "space": {
      "enum": [
        "in-place",
        "mat",
        "walking"
      ]
    },
    "floorRequired": {
      "type": "boolean"
    },
    "impact": {
      "enum": [
        "none",
        "low",
        "high"
      ]
    },
    "sweat": {
      "enum": [
        "none",
        "light",
        "moderate",
        "high"
      ]
    },
    "requiredEquipment": {
      "type": "array",
      "items": {
        "enum": [
          "mat",
          "chair",
          "wall",
          "doorframe",
          "block",
          "towel",
          "band",
          "mini-band",
          "dumbbell",
          "kettlebell",
          "barbell",
          "bench",
          "slider",
          "parallettes",
          "pullup-bar",
          "dip-bars",
          "rings",
          "foam-roller",
          "swiss-ball",
          "cable",
          "d-handle",
          "ankle-strap",
          "landmine",
          "roman-chair",
          "ghd",
          "reverse-hyper",
          "hip-abductor-machine",
          "leg-extension-machine",
          "water-bottle",
          "backpack",
          "book",
          "stairs"
        ]
      },
      "uniqueItems": true
    },
    "optionalEquipment": {
      "type": "array",
      "items": {
        "enum": [
          "mat",
          "chair",
          "wall",
          "doorframe",
          "block",
          "towel",
          "band",
          "mini-band",
          "dumbbell",
          "kettlebell",
          "barbell",
          "bench",
          "slider",
          "parallettes",
          "pullup-bar",
          "dip-bars",
          "rings",
          "foam-roller",
          "swiss-ball",
          "cable",
          "d-handle",
          "ankle-strap",
          "landmine",
          "roman-chair",
          "ghd",
          "reverse-hyper",
          "hip-abductor-machine",
          "leg-extension-machine",
          "water-bottle",
          "backpack",
          "book",
          "stairs"
        ]
      },
      "uniqueItems": true
    },
    "substitutes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "for",
          "use"
        ],
        "properties": {
          "for": {
            "enum": [
              "mat",
              "chair",
              "wall",
              "doorframe",
              "block",
              "towel",
              "band",
              "mini-band",
              "dumbbell",
              "kettlebell",
              "barbell",
              "bench",
              "slider",
              "parallettes",
              "pullup-bar",
              "dip-bars",
              "rings",
              "foam-roller",
              "swiss-ball",
              "cable",
              "d-handle",
              "ankle-strap",
              "landmine",
              "roman-chair",
              "ghd",
              "reverse-hyper",
              "hip-abductor-machine",
              "leg-extension-machine",
              "water-bottle",
              "backpack",
              "book",
              "stairs"
            ]
          },
          "use": {
            "type": "array",
            "items": {
              "enum": [
                "mat",
                "chair",
                "wall",
                "doorframe",
                "block",
                "towel",
                "band",
                "mini-band",
                "dumbbell",
                "kettlebell",
                "barbell",
                "bench",
                "slider",
                "parallettes",
                "pullup-bar",
                "dip-bars",
                "rings",
                "foam-roller",
                "swiss-ball",
                "cable",
                "d-handle",
                "ankle-strap",
                "landmine",
                "roman-chair",
                "ghd",
                "reverse-hyper",
                "hip-abductor-machine",
                "leg-extension-machine",
                "water-bottle",
                "backpack",
                "book",
                "stairs"
              ]
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "loadNote": {
            "enum": [
              "lighter",
              "similar",
              "heavier"
            ]
          }
        }
      }
    },
    "trainingType": {
      "type": "array",
      "items": {
        "enum": [
          "strength",
          "static-stretch",
          "dynamic-stretch",
          "mobility",
          "stability-control",
          "cardio",
          "balance",
          "breathing",
          "assessment"
        ]
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "movementPattern": {
      "type": "array",
      "items": {
        "enum": [
          "squat",
          "hinge",
          "lunge",
          "push-horizontal",
          "push-vertical",
          "pull-horizontal",
          "pull-vertical",
          "rotation",
          "anti-rotation",
          "anti-extension",
          "anti-lateral-flexion",
          "carry",
          "gait",
          "isolation"
        ]
      },
      "uniqueItems": true
    },
    "contraction": {
      "type": "array",
      "items": {
        "enum": [
          "dynamic",
          "isometric"
        ]
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "plane": {
      "type": "array",
      "items": {
        "enum": [
          "sagittal",
          "frontal",
          "transverse"
        ]
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "bodyRegion": {
      "type": "array",
      "items": {
        "enum": [
          "upper",
          "core",
          "lower",
          "full"
        ]
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "primaryMuscles": {
      "type": "array",
      "items": {
        "enum": [
          "deltoids",
          "rotator-cuff",
          "triceps",
          "biceps",
          "forearms",
          "serratus",
          "scapular",
          "chest",
          "lats",
          "abs",
          "obliques",
          "erectors",
          "hip-flexors",
          "glute-max",
          "hip-abductors",
          "adductors",
          "quadriceps",
          "hamstrings",
          "calves",
          "tibialis",
          "neck",
          "upper-traps",
          "hip-rotators",
          "peroneals"
        ]
      },
      "uniqueItems": true
    },
    "secondaryMuscles": {
      "type": "array",
      "items": {
        "enum": [
          "deltoids",
          "rotator-cuff",
          "triceps",
          "biceps",
          "forearms",
          "serratus",
          "scapular",
          "chest",
          "lats",
          "abs",
          "obliques",
          "erectors",
          "hip-flexors",
          "glute-max",
          "hip-abductors",
          "adductors",
          "quadriceps",
          "hamstrings",
          "calves",
          "tibialis",
          "neck",
          "upper-traps",
          "hip-rotators",
          "peroneals"
        ]
      },
      "uniqueItems": true
    },
    "stabilizers": {
      "type": "array",
      "items": {
        "enum": [
          "deltoids",
          "rotator-cuff",
          "triceps",
          "biceps",
          "forearms",
          "serratus",
          "scapular",
          "chest",
          "lats",
          "abs",
          "obliques",
          "erectors",
          "hip-flexors",
          "glute-max",
          "hip-abductors",
          "adductors",
          "quadriceps",
          "hamstrings",
          "calves",
          "tibialis",
          "neck",
          "upper-traps",
          "hip-rotators",
          "peroneals"
        ]
      },
      "uniqueItems": true
    },
    "stretchedMuscles": {
      "type": "array",
      "items": {
        "enum": [
          "deltoids",
          "rotator-cuff",
          "triceps",
          "biceps",
          "forearms",
          "serratus",
          "scapular",
          "chest",
          "lats",
          "abs",
          "obliques",
          "erectors",
          "hip-flexors",
          "glute-max",
          "hip-abductors",
          "adductors",
          "quadriceps",
          "hamstrings",
          "calves",
          "tibialis",
          "neck",
          "upper-traps",
          "hip-rotators",
          "peroneals"
        ]
      },
      "uniqueItems": true
    },
    "joints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "joint",
          "actions"
        ],
        "properties": {
          "joint": {
            "enum": [
              "cervical-spine",
              "thoracic-spine",
              "lumbar-spine",
              "scapulothoracic",
              "shoulder",
              "elbow",
              "forearm",
              "wrist",
              "hip",
              "knee",
              "ankle"
            ]
          },
          "actions": {
            "type": "array",
            "items": {
              "enum": [
                "flexion",
                "extension",
                "abduction",
                "adduction",
                "internal-rotation",
                "external-rotation",
                "horizontal-abduction",
                "horizontal-adduction",
                "rotation",
                "lateral-flexion",
                "elevation",
                "depression",
                "protraction",
                "retraction",
                "upward-rotation",
                "downward-rotation",
                "pronation",
                "supination",
                "dorsiflexion",
                "plantarflexion",
                "inversion",
                "eversion",
                "radial-deviation",
                "ulnar-deviation",
                "circumduction",
                "isometric-hold"
              ]
            },
            "uniqueItems": true,
            "minItems": 1
          }
        }
      }
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "intensity": {
      "enum": [
        "low",
        "moderate",
        "high"
      ]
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "enum": [
          "floor-transfer",
          "kneeling-tolerance",
          "wrist-loading",
          "overhead-range",
          "deep-squat-range",
          "hip-hinge",
          "neutral-spine",
          "single-leg-supported",
          "single-leg-unsupported",
          "split-stance",
          "plank-30s",
          "pushup-10",
          "hang-30s",
          "pullup-1",
          "band-anchor"
        ]
      },
      "uniqueItems": true
    },
    "laterality": {
      "enum": [
        "bilateral",
        "unilateral",
        "alternating"
      ]
    },
    "jointStress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "knee",
        "lumbar",
        "shoulder",
        "wrist",
        "neck",
        "ankle",
        "hip"
      ],
      "properties": {
        "knee": {
          "enum": [
            "none",
            "low",
            "moderate"
          ]
        },
        "lumbar": {
          "enum": [
            "none",
            "low",
            "moderate"
          ]
        },
        "shoulder": {
          "enum": [
            "none",
            "low",
            "moderate"
          ]
        },
        "wrist": {
          "enum": [
            "none",
            "low",
            "moderate"
          ]
        },
        "neck": {
          "enum": [
            "none",
            "low",
            "moderate"
          ]
        },
        "ankle": {
          "enum": [
            "none",
            "low",
            "moderate"
          ]
        },
        "hip": {
          "enum": [
            "none",
            "low",
            "moderate"
          ]
        }
      }
    },
    "populationNotes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "population",
          "flag"
        ],
        "properties": {
          "population": {
            "enum": [
              "beginner",
              "older-adult",
              "pregnancy",
              "postpartum",
              "hypertension",
              "overweight"
            ]
          },
          "flag": {
            "enum": [
              "suitable",
              "modify",
              "caution"
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "enum": [
                "supine-position",
                "prone-position",
                "breath-holding-risk",
                "head-below-heart",
                "high-impact",
                "balance-demand",
                "floor-transfer",
                "heavy-load",
                "abdominal-pressure",
                "end-range-stretch",
                "low-demand"
              ]
            },
            "uniqueItems": true
          }
        }
      }
    },
    "sessionRole": {
      "type": "array",
      "items": {
        "enum": [
          "warmup",
          "main",
          "cooldown"
        ]
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "goals": {
      "type": "array",
      "items": {
        "enum": [
          "strength",
          "hypertrophy",
          "fat-loss",
          "posture",
          "desk-relief",
          "mobility",
          "performance",
          "recovery"
        ]
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "uniqueItems": true
    },
    "regressions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "uniqueItems": true
    },
    "progressions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "uniqueItems": true
    },
    "aiSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zh",
        "en"
      ],
      "properties": {
        "zh": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "existing",
          "chosen",
          "reason"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "existing": {},
          "chosen": {},
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "reviewNotes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "trainingType": {
            "contains": {
              "enum": [
                "static-stretch",
                "dynamic-stretch"
              ]
            }
          }
        }
      },
      "then": {
        "required": [
          "stretchedMuscles"
        ],
        "properties": {
          "stretchedMuscles": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
