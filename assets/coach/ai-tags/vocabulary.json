    "trainingType": {
      "type": "multi",
      "required": true,
      "description": "训练类型，第一个为主类型。由 v3 tags.category 映射：strength→strength，stretch→static-stretch 或 dynamic-stretch（看是否停住保持），mobility→mobility，stability→stability-control，balance→balance，cardio→cardio，assessment→按实际做法（多为 mobility/static-stretch，notes 注明）。",
      "legacyCategoryMap": {
        "strength": [
          "strength"
        ],
        "stretch": [
          "static-stretch",
          "dynamic-stretch"
        ],
        "mobility": [
          "mobility",
          "dynamic-stretch"
        ],
        "stability": [
          "stability-control"
        ],
        "balance": [
          "balance"
        ],
        "cardio": [
          "cardio"
        ],
        "assessment": [
          "mobility",
          "static-stretch"
        ],
        "core": [
          "strength",
          "stability-control"
        ]
      },
      "values": {
        "strength": {
          "zh": "力量",
          "en": "Strength",
          "definition": "对抗自重或外部阻力，反复做到肌肉疲劳，提升力量或肌肉量。"
        },
        "static-stretch": {
          "zh": "静态拉伸",
          "en": "Static stretch",
          "definition": "进入拉伸位后停住保持 15 秒以上，目标是拉长肌肉。"
        },
        "dynamic-stretch": {
          "zh": "动态拉伸",
          "en": "Dynamic stretch",
          "definition": "有节奏地进出拉伸位、每次停留很短，用于热身。"
        },
        "mobility": {
          "zh": "灵活性",
          "en": "Mobility",
          "definition": "主动控制关节在较大范围内活动（画圈、转动、开合），重点是关节活动度而非拉长单块肌肉。"
        },
        "stability-control": {
          "zh": "稳定控制",
          "en": "Stability & control",
          "definition": "保持躯干或关节姿势对抗外力/重力（平板、抗旋转、鸟狗），重点是不动或慢速控制。"
        },
        "cardio": {
          "zh": "有氧",
          "en": "Cardio",
          "definition": "连续动作使心率持续升高。"
        },
        "balance": {
          "zh": "平衡",
          "en": "Balance",
          "definition": "缩小支撑面（单腿、窄站）并控制重心。"
        },
        "breathing": {
          "zh": "呼吸",
          "en": "Breathing",
          "definition": "以呼吸节奏、腹式/肋间呼吸为主要内容。"
        },
        "assessment": {
          "zh": "评估",
          "en": "Assessment",
          "definition": "用来测试活动度或能力的动作；AI 编排训练时默认不选，除非用户要求自测。"
        }
      }
    },
    "movementPattern": {
      "type": "multi",
      "required": true,
      "description": "基本动作模式；纯静态拉伸、呼吸或不属于下列模式的关节活动可为空数组。",
      "values": {
        "squat": {
          "zh": "蹲",
          "en": "Squat",
          "definition": "双腿屈髋屈膝下蹲再站起，膝和髋都大幅活动。"
        },
        "hinge": {
          "zh": "髋铰链",
          "en": "Hinge",
          "definition": "以髋为轴前倾/抬起躯干，背保持平直，膝微屈（硬拉、臀桥、早安）。"
        },
        "lunge": {
          "zh": "弓步/分腿",
          "en": "Lunge",
          "definition": "前后或左右分腿，单腿为主承重（弓步、分腿蹲、上台阶）。"
        },
        "push-horizontal": {
          "zh": "水平推",
          "en": "Horizontal push",
          "definition": "手臂向身体前方推离（俯卧撑、卧推）。"
        },
        "push-vertical": {
          "zh": "垂直推",
          "en": "Vertical push",
          "definition": "手臂向头顶上方推（推举、倒立撑）。"
        },
        "pull-horizontal": {
          "zh": "水平拉",
          "en": "Horizontal pull",
          "definition": "手臂从前方拉向躯干（划船、反向飞鸟）。"
        },
        "pull-vertical": {
          "zh": "垂直拉",
          "en": "Vertical pull",
          "definition": "手臂从头顶上方往下拉（引体、下拉）。"
        },
        "rotation": {
          "zh": "旋转",
          "en": "Rotation",
          "definition": "躯干或髋主动转动。"
        },
        "anti-rotation": {
          "zh": "抗旋转",
          "en": "Anti-rotation",
          "definition": "对抗让躯干转动的力（Pallof、单手提物、鸟狗）。"
        },
        "anti-extension": {
          "zh": "抗伸展",
          "en": "Anti-extension",
          "definition": "对抗腰往下塌（平板、死虫、空心体）。"
        },
        "anti-lateral-flexion": {
          "zh": "抗侧屈",
          "en": "Anti-lateral flexion",
          "definition": "对抗躯干侧弯（侧平板、单手提物行走）。"
        },
        "carry": {
          "zh": "负重行走/保持",
          "en": "Carry",
          "definition": "手持负重站立或行走。"
        },
        "gait": {
          "zh": "步态",
          "en": "Gait",
          "definition": "行走、踏步、抬膝、爬行等交替下肢模式。"
        },
        "isolation": {
          "zh": "单关节孤立",
          "en": "Isolation",
          "definition": "主要只动一个关节（弯举、侧平举、踮脚、腿屈伸）。"
        }
      }
    },
    "contraction": {
      "type": "multi",
      "required": true,
      "description": "主要收缩方式；rep_hold 类可同时含两者。",
      "values": {
        "dynamic": {
          "zh": "动态",
