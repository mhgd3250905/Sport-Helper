    "jointStress": {
      "type": "object",
      "required": true,
      "keys": [
        "knee",
        "lumbar",
        "shoulder",
        "wrist",
        "neck",
        "ankle",
        "hip"
      ],
      "description": "按默认剂量、正确做法时各关节的负担。七个键都必填。高负担动作也只用 moderate，说明需要注意；不表示安全或危险的医疗判断。",
      "values": {
        "none": {
          "zh": "无",
          "en": "None",
          "definition": "该关节基本不承力或只轻微活动。"
        },
        "low": {
          "zh": "低",
          "en": "Low",
          "definition": "该关节参与但负担小，一般人无感。"
        },
        "moderate": {
          "zh": "需注意",
          "en": "Moderate",
          "definition": "该关节承重/末端/反复受力，此处有不适的人应减量或换动作。"
