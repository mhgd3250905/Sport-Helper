{
  "format": "pose-hub-ai-vocabulary@1",
  "version": "0.1.0",
  "status": "draft-phase1",
  "date": "2026-11-03",
  "purpose": "AI 选动作用的固定词表。每个动作标签文件 catalog/ai-tags/actions/<id>.json 的枚举值只能取这里的 id。只有 aiSummary、notes、reviewNotes 是自由文本。",
  "sources": [
    "catalog/production/v3-text/*.json（249 份 r2 文案与 tags，权威动作清单）",
    "catalog/taxonomy.json（20 个肌群、器械、体位、场所）",
    "catalog/catalog.json（v0.3 旧目录 142 个，仅作交叉参考）"
  ],
  "dimensions": {
    "scenes": {
      "type": "multi",
      "required": true,
      "description": "能在哪些场所做。按动作本身的需求判断，不按'谁会用'判断。",
      "values": {
        "home": {
          "zh": "居家",
          "en": "Home",
          "definition": "家里客厅或卧室：有地面、墙、椅子，可铺垫子；默认有 mat/chair/wall/towel/book/water-bottle。"
        },
        "office": {
          "zh": "办公室",
          "en": "Office",
          "definition": "工位旁穿着通勤衣服可做：不躺地不跪地（floorRequired=false），impact=none，sweat≤light；默认只有 chair/wall/desk。"
        },
        "gym": {
          "zh": "健身房",
          "en": "Gym",
          "definition": "有全部常见器械；居家能做的动作健身房都能做，但只有需要健身房器械时才只标 gym。"
        },
        "outdoor": {
          "zh": "户外",
          "en": "Outdoor",
          "definition": "公园、操场：地面可能脏或不平，不默认有垫子；站姿、行走、借助长椅/栏杆的动作适合。"
        },
        "hotel": {
          "zh": "酒店",
          "en": "Hotel",
          "definition": "酒店房间：空间小、地毯或地板、床/椅子/墙，没有器械，楼下有人（impact 应为 none/low）。"
        }
      }
    },
    "space": {
      "type": "single",
      "required": true,
      "description": "动作占用的地面空间。",
      "values": {
        "in-place": {
          "zh": "原地",
          "en": "In place",
          "definition": "站或坐在约 1×1 米内完成，不需要铺开身体。"
        },
        "mat": {
          "zh": "一张垫子",
          "en": "Mat-sized",
          "definition": "身体需要铺开（躺、跪、俯撑、侧卧），约 2×1 米。"
        },
        "walking": {
          "zh": "需要走动",
          "en": "Walking room",
          "definition": "动作要向前/侧移动几步以上（行走、侧步、爬行），需要 3 米以上通道。"
        }
      }
    },
    "floorRequired": {
      "type": "boolean",
      "required": true,
      "description": "是否需要身体躺、跪、坐或撑在地面上（脚以外部位着地）。true 的动作办公室默认不推荐。与 taxonomy positions.*.floor 一致，但坐在地上的 seated 也算 true。"
    },
    "impact": {
      "type": "single",
      "required": true,
      "description": "跳跃/冲击与噪音。",
      "values": {
        "none": {
          "zh": "无冲击",
          "en": "None",
          "definition": "双脚或支撑点始终不离地，几乎没有声音。"
        },
        "low": {
          "zh": "低冲击",
          "en": "Low",
          "definition": "有踏步、脚步落地或器械轻碰，声音很小，楼下基本听不到。"
        },
        "high": {
          "zh": "高冲击",
          "en": "High",
          "definition": "跳跃、双脚离地落下，会有明显声音，可能打扰楼下。"
        }
      }
    },
    "sweat": {
      "type": "single",
      "required": true,
      "description": "按默认剂量做完后的出汗程度，用于办公室/通勤场景过滤。",
      "values": {
        "none": {
          "zh": "不出汗",
          "en": "None",
          "definition": "穿通勤衣服做完不会出汗。"
        },
        "light": {
          "zh": "微汗",
          "en": "Light",
          "definition": "可能微微发热，一般不需要换衣服。"
        },
        "moderate": {
          "zh": "明显出汗",
          "en": "Moderate",
          "definition": "会出汗，做完最好擦汗或换衣服。"
        },
        "high": {
          "zh": "大量出汗",
          "en": "High",
          "definition": "连续高心率，衣服会湿。"
        }
      }
    },
    "requiredEquipment": {
      "type": "multi",
      "required": true,
      "vocabulary": "equipment",
      "description": "不具备就不能按原样做的器械。空数组 = 徒手。mat 只在躺跪撑地时算必需；软地毯/床可替代时仍写 mat，替代写 substitutes。"
    },
    "optionalEquipment": {
      "type": "multi",
      "required": true,
      "vocabulary": "equipment",
      "description": "有了更舒服或更好调节、但不是必需的器械（例如站姿动作扶墙可选）。"
    },
    "substitutes": {
      "type": "list",
      "required": true,
      "description": "必需器械的家用替代。每项 {for: equipment id, use: [equipment id...], loadNote: 'lighter'|'similar'|'heavier'}。例如 {for:'dumbbell', use:['water-bottle'], loadNote:'lighter'}。",
      "itemShape": {
        "for": "equipment id",
        "use": "[equipment id]",
        "loadNote": "lighter|similar|heavier"
      }
    },
    "equipment": {
      "type": "vocabulary-only",
      "description": "器械 id 表。aliases 是 v3 文案 tags.equipment 中出现过的同义写法，批量打标时归一到本 id。",
