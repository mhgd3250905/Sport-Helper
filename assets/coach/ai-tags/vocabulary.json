    "difficulty": {
      "type": "integer",
      "required": true,
      "minimum": 1,
      "maximum": 5,
      "description": "1–5 级。v3 文案用 1–3，本表扩到 5 级以容纳技巧类动作：v3 的 1/2/3 一般对应本表 1/2/3，只有技巧/高力量动作上调到 4–5，差异写 notes。",
      "levels": {
        "1": {
          "zh": "入门",
          "en": "Beginner",
          "definition": "支撑面大或有扶靠，徒手或很轻负重，动作简单，第一次做跟着口令就能做对。"
