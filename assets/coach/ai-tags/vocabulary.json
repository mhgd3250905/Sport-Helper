    "laterality": {
      "type": "single",
      "required": true,
      "description": "左右侧方式。注意 v3 的 unilateral=true 同时包含了单侧和交替两种。",
      "values": {
        "bilateral": {
          "zh": "双侧同时",
          "en": "Bilateral",
          "definition": "左右同时做同样的事。"
        },
        "unilateral": {
          "zh": "单侧",
          "en": "Unilateral",
          "definition": "一侧做完规定量再换另一侧（training.perSide=each-side-separately）。"
