  "definitions": {
    "durations": "milliseconds; UI is FrameTiming.buildDuration; raster is FrameTiming.rasterDuration",
    "coverage": "Flutter engine frame timings only; embedded WebView compositor and video frames are not measured; no screen-present FPS or actual display-present dropped-frame measurement is provided",
    "overBudgetFrames": "duration > 1000 / refreshRateHz, separately per thread; union counts a frame once when either thread exceeds budget",
    "estimatedMissedVsyncs": "sum(max(0, ceil(max(buildUs, rasterUs) / (1000000 / refreshRateHz)) - 1)); throughput estimate, not measured display-present drops",
    "percentiles": "nearest rank, logarithmic histogram upper bound capped at observed maximum; error <= 6.25% of duration or 1 microsecond; averages and worst frames are exact",
    "attribution": "labels start on next scheduler frame; PlatformDispatcher.frameData.frameNumber matches FrameTiming.frameNumber; delayed batches use retained frame-key history, not callback time or presentation timestamps",
    "unattributed": "frames without retained label history are counted and excluded from duration/budget statistics rather than guessed",
    "lifecycle": "only resumed state is collected; engine batches pending at stop/pause may not be delivered; pre-reset frames are excluded",
    "refreshRate": "per-frame label rate; initial 60 Hz is an assumption until the app supplies a display rate",
    "scenarios": "one explicit scenario at a time; frames outside a scenario remain in totals and page statistics; settings and performance_settings pages are excluded from scenario statistics",
    "conditionChangesDuringCapture": "number of changes to previously supplied theme, appearance, starfield, glassQuality, scrollCardGlassEnabled or refresh-rate values while running; initial values and device metadata readiness do not count; reset clears the count and retains current conditions",
    "comparisonWindows": "warmupFirst2Seconds is [first case FrameTiming.vsyncStart, +2 s); steadyState begins at +2 s; firstPageEntryFirst2Seconds independently covers the first observed entry of each page in this round, and may overlap warmup or steady state; spikes do not prove shader compilation",
    "comparisonEligibility": "completed; >=30 s observed case vsync span; steady frames present; one actual render condition and one refresh rate; verified renderer; variant matches actual switches; long chat >=60 messages; no condition overflow or out-of-order case timestamps",
    "scrollCardGlassEnabled": "actual scroll-card renderer; false is a static simulated-glass surface without backdrop filters or scroll background capture; true is the internal-only real-glass comparison override and requires the global glass switch; glass_on/off variants still describe the global switch, not the card renderer; raster_controls_v2 reports did not record this field",
    "fixedGlassCases": "independent same-scene fixed-surface experiments; plan policy never applies to chat; absent top/bottom roles are N/A, not cells; entryFirst2Seconds starts on the first observed target-page frame after a route-push request, separate from scripted scroll windows; prewarm succeeded confirms a rendered attempt, not a guarantee that every driver shader or pipeline was compiled"
