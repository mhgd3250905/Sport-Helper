-class _StatusSentenceState extends State<_StatusSentence>
-    with SingleTickerProviderStateMixin {
-  late final AnimationController _transition;
-  String? _previous;
-
-  @override
-  void initState() {
-    super.initState();
-    _transition = AnimationController(
-      vsync: this,
-      duration:
-          SfGenerationTokens.statusDelay + SfGenerationTokens.statusTransition,
-      value: 1,
-    );
-  }
-
-  @override
-  void didUpdateWidget(_StatusSentence oldWidget) {
-    super.didUpdateWidget(oldWidget);
-    if (widget.reduced) {
-      _transition.stop();
-      _transition.value = 1;
-      _previous = null;
-    } else if (oldWidget.text != widget.text) {
-      _previous = oldWidget.text;
-      _transition.forward(from: 0);
-    }
-  }
-
-  @override
-  void dispose() {
-    _transition.dispose();
-    super.dispose();
-  }
-
-  @override
-  Widget build(BuildContext context) {
-    final style = SfGenerationTokens.status;
-    final height =
-        MediaQuery.textScalerOf(context).scale(style.fontSize!) * style.height!;
-    return Semantics(
-      label: widget.text,
-      liveRegion: true,
-      child: ExcludeSemantics(
-        child: SizedBox(
-          key: const ValueKey('generation-status'),
-          height: height,
-          child: AnimatedBuilder(
-            animation: Listenable.merge([_transition, widget.shimmer]),
-            builder: (context, _) {
-              Widget text(String value) {
-                final sentence = Text(
-                  value,
-                  style: style,
-                  maxLines: 1,
-                  softWrap: false,
-                  overflow: TextOverflow.clip,
-                );
-                if (widget.reduced) return sentence;
-                return ShaderMask(
-                  shaderCallback: (bounds) {
-                    // CSS: background-size 250%, background-position 100% ->
-                    // -150%. Offset = (W - 2.5W) * p, so the band travels left
-                    // to right and leaves a dark gap between passes.
-                    final width = bounds.width;
-                    const span = SfGenerationTokens.shimmerSpan;
-                    final p = 1 + (-1.5 - 1) * widget.shimmer.value;
-                    final left = (width - span * width) * p;
-                    return LinearGradient(
-                      colors: [
-                        SfColors.muted,
-                        SfColors.muted,
-                        SfGenerationTokens.highlight,
-                        SfColors.muted,
-                        SfColors.muted,
-                      ],
-                      stops: SfGenerationTokens.shimmerStops,
-                    ).createShader(
-                      Rect.fromLTWH(left, 0, span * width, bounds.height),
-                    );
-                  },
-                  blendMode: BlendMode.srcIn,
-                  child: sentence,
-                );
-              }
-
-              if (widget.reduced) return text(widget.text);
-              final elapsed =
-                  _transition.value *
-                  (SfGenerationTokens.statusDelay +
-                          SfGenerationTokens.statusTransition)
-                      .inMicroseconds;
-              final outgoing = Curves.easeInCubic.transform(
-                (elapsed / SfGenerationTokens.statusExit.inMicroseconds).clamp(
-                  0.0,
-                  1.0,
-                ),
-              );
-              final incoming = Curves.easeOutCubic.transform(
-                ((elapsed - SfGenerationTokens.statusDelay.inMicroseconds) /
-                        SfGenerationTokens.statusTransition.inMicroseconds)
-                    .clamp(0.0, 1.0),
-              );
-              return ClipRect(
-                child: Stack(
-                  alignment: Alignment.centerLeft,
-                  children: [
-                    if (outgoing < 1 && _previous != null)
-                      Opacity(
-                        opacity: 1 - outgoing,
-                        child: Transform.translate(
-                          offset: Offset(
-                            0,
-                            -SfGenerationTokens.statusOffset * outgoing,
-                          ),
-                          child: text(_previous!),
-                        ),
-                      ),
-                    Opacity(
-                      opacity: incoming,
-                      child: Transform.translate(
-                        offset: Offset(
-                          0,
-                          SfGenerationTokens.statusOffset * (1 - incoming),
-                        ),
-                        child: text(widget.text),
-                      ),
-                    ),
-                  ],
-                ),
-              );
-            },
-          ),
-        ),
-      ),
-    );
-  }
-}
